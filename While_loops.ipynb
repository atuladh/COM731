    "#Ask user for number of cables to remove\n",
    "num = int(input(\"How many cables should I remove?\"))\n",
    "removed = 0     #Cables removed\n",
    "while removed < num:\n",
    "    print(\"Removed cable.\")\n",
    "    removed = removed + 1\n",
    "    "
   ]
